generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analysisSessions AnalysisSession[]

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model AnalysisSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title            String
  originalFileName String

  datasetPath String
  reportPath  String?

  status     String    @default("PROCESSING")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  businessQuestions String? @db.Text

  celeryTaskId String?

  modelName String?

  durationSeconds Float?
  totalTokens     Int?

  processes AnalysisProcess[]
}

model AnalysisProcess {
  id                String          @id @default(cuid())
  analysisSessionId String
  analysisSession   AnalysisSession @relation(fields: [analysisSessionId], references: [id], onDelete: Cascade)

  type      ProcessType
  name      String
  event     ProcessEvent
  timestamp DateTime     @default(now())
  details   String?      @db.Text

  @@index([analysisSessionId])
}

enum ProcessType {
  AGENT
  TOOL
}

enum ProcessEvent {
  START
  END
}
