flowchart TD

%% ============================================================
%% DATA ANALYTICS AI PLATFORM — ACTIVITY DIAGRAM
%% Covers: Auth · Upload & Analysis · Report · Project Management
%% ============================================================

    START(["●\nStart"]):::startEnd

%% ══════════════════════════════════════════════════════════
%%  FLOW 1 — AUTHENTICATION
%% ══════════════════════════════════════════════════════════
    START --> A_LAND["Visit Application"]
    A_LAND --> A_AUTH{"Authenticated?"}

    A_AUTH -- "No" --> A_CHOOSE{"Sign Up or\nSign In?"}
    A_CHOOSE -- "Sign Up" --> A_SIGNUP["Fill Registration Form\n(name, email, password)"]
    A_SIGNUP --> A_SIGNUP_OK{"Registration\nSuccessful?"}
    A_SIGNUP_OK -- "No (validation error)" --> A_SIGNUP
    A_SIGNUP_OK -- "Yes" --> A_DASHBOARD

    A_CHOOSE -- "Sign In" --> A_SIGNIN["Enter Credentials\n(email, password)"]
    A_SIGNIN --> A_SIGNIN_OK{"Credentials\nValid?"}
    A_SIGNIN_OK -- "No" --> A_SIGNIN
    A_SIGNIN_OK -- "Yes" --> A_DASHBOARD

    A_AUTH -- "Yes" --> A_DASHBOARD

%% ══════════════════════════════════════════════════════════
%%  FLOW 2 — DASHBOARD NAVIGATION
%% ══════════════════════════════════════════════════════════
    A_DASHBOARD["View Home Dashboard\n(recent projects + upload prompt)"]
    A_DASHBOARD --> A_NAV{"Choose Action"}

    A_NAV -- "Upload Dataset" --> B_OPEN_MODAL
    A_NAV -- "View Projects" --> C_PROJECTS
    A_NAV -- "Click Recent Project" --> E_REPORT
    A_NAV -- "Sign Out" --> A_SIGNOUT["Sign Out\n(clear session)"]
    A_SIGNOUT --> START

%% ══════════════════════════════════════════════════════════
%%  FLOW 3 — UPLOAD & ANALYSIS
%% ══════════════════════════════════════════════════════════
    B_OPEN_MODAL["Open Upload Modal"]
    B_OPEN_MODAL --> B_SELECT["Select CSV File\nfrom local disk"]
    B_SELECT --> B_VALID{"File is valid\nCSV?"}
    B_VALID -- "No" --> B_SELECT
    B_VALID -- "Yes" --> B_PREVIEW["Preview Data Sample\n(first N rows shown)"]

    B_PREVIEW --> B_BQ["Enter Business Questions\n(text input)"]
    B_BQ --> B_MODEL["Select AI Model\n(dropdown)"]
    B_MODEL --> B_SUBMIT["Click Generate Insights"]

    B_SUBMIT --> B_CHUNK_INIT["Initialize Chunked Upload\n(POST /upload/init)"]
    B_CHUNK_INIT --> B_UPLOADING["Upload File Chunks\n(sequential, progress bar)"]
    B_UPLOADING --> B_CHUNK_DONE{"All chunks\nuploaded?"}
    B_CHUNK_DONE -- "No (network error)" --> B_UPLOADING
    B_CHUNK_DONE -- "Yes" --> B_COMPLETE["Complete Upload\n(POST /upload/complete)"]

    B_COMPLETE --> B_REDIRECT["Redirect to Report Page\n(session_id)"]
    B_REDIRECT --> B_PROCESSING

%% ══════════════════════════════════════════════════════════
%%  FLOW 4 — PROCESSING TRACKER
%% ══════════════════════════════════════════════════════════
    B_PROCESSING["Poll Processing Status\n(GET /report · every few seconds)"]
    B_PROCESSING --> B_STATUS{"Current\nStatus?"}

    B_STATUS -- "PROCESSING data_preprocessing_agent" --> B_STAGE1["🧹 Stage 1: Data Preprocessing\n(timeline node active)"]
    B_STATUS -- "PROCESSING eda_agent" --> B_STAGE2["📈 Stage 2: Exploratory Analysis\n(timeline node active)"]
    B_STATUS -- "PROCESSING data_explainer_agent" --> B_STAGE3["📝 Stage 3: Data Explanation\n(timeline node active)"]
    B_STAGE1 --> B_PROCESSING
    B_STAGE2 --> B_PROCESSING
    B_STAGE3 --> B_PROCESSING

    B_STATUS -- "COMPLETED" --> E_REPORT
    B_STATUS -- "FAILED" --> B_FAILED["Show Error State\n(analysis failed)"]
    B_STATUS -- "CANCELLED" --> B_CANCELLED["Show Cancelled State"]
    B_FAILED --> A_NAV
    B_CANCELLED --> A_NAV

    B_STATUS -- "Still processing" --> B_CANCEL_BTN{"User clicks\nCancel?"}
    B_CANCEL_BTN -- "No" --> B_PROCESSING
    B_CANCEL_BTN -- "Yes" --> B_CONFIRM_CANCEL{"Confirm\nCancellation?"}
    B_CONFIRM_CANCEL -- "No" --> B_PROCESSING
    B_CONFIRM_CANCEL -- "Yes" --> B_DO_CANCEL["Send Cancel Request\n(POST /cancel/{id})"]
    B_DO_CANCEL --> B_CANCELLED

%% ══════════════════════════════════════════════════════════
%%  FLOW 5 — VIEW REPORT
%% ══════════════════════════════════════════════════════════
    E_REPORT["Display Analysis Report\n(Markdown rendered)"]
    E_REPORT --> E_ACTIONS{"User Action\non Report?"}

    E_ACTIONS -- "Scroll / Read" --> E_TOC["Navigate Table of Contents\n(jump to section)"]
    E_TOC --> E_ACTIONS

    E_ACTIONS -- "Regenerate" --> E_REGEN["Click Regenerate Report"]
    E_REGEN --> E_REGEN_CONFIRM{"Confirm\nRegenerate?"}
    E_REGEN_CONFIRM -- "No" --> E_ACTIONS
    E_REGEN_CONFIRM -- "Yes" --> E_REGEN_REQ["POST /regenerate/{id}\n(new session created)"]
    E_REGEN_REQ --> B_PROCESSING

    E_ACTIONS -- "Go Back to Projects" --> C_PROJECTS
    E_ACTIONS -- "Go to Dashboard" --> A_DASHBOARD

%% ══════════════════════════════════════════════════════════
%%  FLOW 6 — PROJECT MANAGEMENT
%% ══════════════════════════════════════════════════════════
    C_PROJECTS["View All Projects\n(grid + stats row, auto-refresh every 2s)"]
    C_PROJECTS --> C_SEARCH["Search / Filter Projects\n(query param)"]
    C_SEARCH --> C_ACTION{"Select a\nProject Action"}

    C_ACTION -- "Click Project Card" --> C_STATUS_GUARD{"Project\nStatus?"}
    C_STATUS_GUARD -- "Failed" --> C_NO_NAV["(No navigation —\nproject failed)"]
    C_NO_NAV --> C_ACTION
    C_STATUS_GUARD -- "Completed / Processing" --> E_REPORT

    C_ACTION -- "Rename Project" --> C_RENAME_MODAL["Open Rename Modal\n(enter new title)"]
    C_RENAME_MODAL --> C_RENAME_SUBMIT["Submit Rename\n(PATCH /api/projects)"]
    C_RENAME_SUBMIT --> C_RENAME_OK{"Success?"}
    C_RENAME_OK -- "No" --> C_RENAME_MODAL
    C_RENAME_OK -- "Yes" --> C_PROJECTS

    C_ACTION -- "Delete Project" --> C_DEL_CONFIRM{"Confirm\nDelete?"}
    C_DEL_CONFIRM -- "No" --> C_ACTION
    C_DEL_CONFIRM -- "Yes" --> C_DEL_REQ["DELETE /api/projects\n(remove dataset + outputs)"]
    C_DEL_REQ --> C_DEL_OK{"Success?"}
    C_DEL_OK -- "No" --> C_DEL_ERR["Show Error Alert"]
    C_DEL_ERR --> C_ACTION
    C_DEL_OK -- "Yes" --> C_PROJECTS

    C_ACTION -- "Upload New Dataset" --> B_OPEN_MODAL
    C_ACTION -- "Go to Dashboard" --> A_DASHBOARD

%% ─── END ─────────────────────────────────────────────────────
    END(["⏹\nEnd"]):::startEnd
    A_SIGNOUT -.-> END

%% ─── STYLES ──────────────────────────────────────────────────
    classDef startEnd fill:#1e3a5f,stroke:#4a90d9,stroke-width:3px,color:#ffffff,font-weight:bold
    classDef decision fill:#1a2e1a,stroke:#16a34a,stroke-width:1.5px,color:#bbf7d0
    classDef action fill:#0f2340,stroke:#3b82f6,stroke-width:1.5px,color:#bfdbfe
    classDef stage fill:#2a1a3e,stroke:#7c3aed,stroke-width:1.5px,color:#ddd6fe

    class START,END startEnd
    class A_AUTH,A_CHOOSE,A_SIGNUP_OK,A_SIGNIN_OK,A_NAV,B_VALID,B_CHUNK_DONE,B_STATUS,B_CANCEL_BTN,B_CONFIRM_CANCEL,E_ACTIONS,E_REGEN_CONFIRM,C_ACTION,C_STATUS_GUARD,C_RENAME_OK,C_DEL_CONFIRM,C_DEL_OK decision
    class A_LAND,A_SIGNUP,A_SIGNIN,A_DASHBOARD,A_SIGNOUT,B_OPEN_MODAL,B_SELECT,B_PREVIEW,B_BQ,B_MODEL,B_SUBMIT,B_CHUNK_INIT,B_UPLOADING,B_COMPLETE,B_REDIRECT,B_PROCESSING,B_DO_CANCEL,B_CANCELLED,B_FAILED,E_REPORT,E_TOC,E_REGEN,E_REGEN_REQ,C_PROJECTS,C_SEARCH,C_NO_NAV,C_RENAME_MODAL,C_RENAME_SUBMIT,C_DEL_REQ,C_DEL_ERR action
    class B_STAGE1,B_STAGE2,B_STAGE3 stage
