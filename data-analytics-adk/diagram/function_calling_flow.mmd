graph TD
    %% Define Styles
    classDef agent fill:#e1f5fe,stroke:#03a9f4,stroke-width:2px,color:#000
    classDef tool fill:#fff3e0,stroke:#ff9800,stroke-width:2px,color:#000
    classDef data fill:#fce4ec,stroke:#e91e63,stroke-width:2px,color:#000
    classDef logic fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px,color:#000

    Start([User Request / Task]) --> Agent

    subgraph Agentic_Loop ["🔁 The Agentic Function Calling Loop"]
        
        Agent["🧠 LLM Agent<br/>(Reasons about task & current state)"]:::agent
        
        Decision{"What is the next step?"}:::logic
        
        Agent --> Decision
        
        Decision -- "Needs Data or Action" --> ToolCall["📞 Initiates Tool Call<br/>(e.g., run_sql_tool)"]:::agent
        
        subgraph Execution_Layer ["🛠️ Tool Execution Layer"]
            ToolCall --> Execute["⚙️ Framework executes python function"]:::tool
            Execute --> DuckDB[("💾 DuckDB / Disk<br/>(Processes actual data)")]:::data
            DuckDB --> ToolReturn["📝 Tool returns summary/metadata<br/>(e.g., 'Table created, 50 rows')"]:::tool
        end
        
        ToolReturn --> Observe["👀 Agent Observes Result<br/>(Appends to conversation history)"]:::agent
        Observe -.-> |"Triggers next thought"| Agent
        
    end

    Decision -- "Task is Complete" --> FinalOutput["✅ Generates Final Output<br/>(Markdown Report)"]:::agent
    FinalOutput --> End([Next Agent or Finish])