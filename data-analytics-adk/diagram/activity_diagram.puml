@startuml activity_diagram
' ============================================================
' DATA ANALYTICS AI PLATFORM — ACTIVITY DIAGRAM
' Covers: Auth · Upload & Analysis · Report · Project Mgmt
' ============================================================

skinparam DefaultFontName               Inter
skinparam BackgroundColor               #060e1f
skinparam ActivityBackgroundColor       #0f2340
skinparam ActivityBorderColor           #3b82f6
skinparam ActivityFontColor             #bfdbfe
skinparam ActivityArrowColor            #4a6fa5
skinparam ActivityDiamondBackgroundColor #1a2e1a
skinparam ActivityDiamondBorderColor    #16a34a
skinparam ActivityDiamondFontColor      #bbf7d0
skinparam PartitionBackgroundColor      #060e1f
skinparam PartitionBorderColor          #2d4a7a
skinparam PartitionFontColor            #90a4cb
skinparam PartitionFontStyle            Bold
skinparam NoteBackgroundColor           #1e3a5f
skinparam NoteBorderColor               #4a90d9
skinparam NoteFontColor                 #e2e8f0

start

' ══════════════════════════════════════════════════════════
'  FLOW 1 — AUTHENTICATION
' ══════════════════════════════════════════════════════════
partition "Authentication" {
    :Visit Application;
    if (Authenticated?) then (Yes)
    else (No)
        if (Sign Up or Sign In?) then (Sign Up)
            repeat
                :Fill Registration Form\n(name, email, password);
            repeat while (Registration Successful?) is (No)
            ->Yes;
        else (Sign In)
            repeat
                :Enter Credentials\n(email, password);
            repeat while (Credentials Valid?) is (No)
            ->Yes;
        endif
    endif
}

' ══════════════════════════════════════════════════════════
'  FLOW 2 — DASHBOARD
' ══════════════════════════════════════════════════════════
partition "Dashboard" {
    :View Home Dashboard\n(recent projects + upload prompt);
    if (Action = Upload Dataset?) then (Yes)
        ' → continues into Upload flow
    elseif (Action = Sign Out?) then (Yes)
        :Sign Out (clear session);
        stop
    else (View Projects / Click Project)
        ' → handled in Project Management flow
    endif
}

' ══════════════════════════════════════════════════════════
'  FLOW 3 — UPLOAD & ANALYSIS
' ══════════════════════════════════════════════════════════
partition "Upload & Analysis" {
    :Open Upload Modal;
    repeat
        :Select CSV File from local disk;
    repeat while (File is valid CSV?) is (No)
    ->Yes;

    :Preview Data Sample\n(first N rows shown);
    :Enter Business Questions\n(text input);
    :Select AI Model\n(dropdown);
    :Click Generate Insights;

    :Initialize Chunked Upload\n(POST /upload/init);
    repeat
        :Upload File Chunks\n(sequential, progress bar);
    repeat while (All chunks uploaded?) is (No)
    ->Yes;

    :Complete Upload\n(POST /upload/complete);
    :Redirect to Report Page\n(session_id);
}

' ══════════════════════════════════════════════════════════
'  FLOW 4 — PROCESSING TRACKER
' ══════════════════════════════════════════════════════════
partition "Processing Tracker" {
    repeat
        :Poll Processing Status\n(GET /report every few seconds);

        if (User clicks Cancel?) then (Yes)
            if (Confirm Cancellation?) then (Yes)
                :Send Cancel Request\n(POST /cancel/{id});
                :Show Cancelled State;
                stop
            else (No)
            endif
        endif

        if (Status = FAILED?) then (Yes)
            :Show Error State\n(analysis failed);
            stop
        elseif (Status = CANCELLED?) then (Yes)
            :Show Cancelled State;
            stop
        elseif (Status = PROCESSING data_preprocessing_agent?) then (Yes)
            note right
                🧹 Stage 1:
                Data Preprocessing
            end note
        elseif (Status = PROCESSING eda_agent?) then (Yes)
            note right
                📈 Stage 2:
                Exploratory Analysis
            end note
        elseif (Status = PROCESSING data_explainer_agent?) then (Yes)
            note right
                📝 Stage 3:
                Data Explanation
            end note
        else (Still processing)
        endif

    repeat while (Status = COMPLETED?) is (No)
    ->Yes;
}

' ══════════════════════════════════════════════════════════
'  FLOW 5 — VIEW REPORT
' ══════════════════════════════════════════════════════════
partition "Report & Results" {
    :Display Analysis Report\n(Markdown rendered);

    if (Action = Navigate ToC?) then (Yes)
        :Navigate Table of Contents\n(jump to section);
        :Continue reading report;
    elseif (Action = Regenerate?) then (Yes)
        if (Confirm Regenerate?) then (Yes)
            :POST /regenerate/{id}\n(new session created);
            ' loops back to Processing Tracker
        else (No)
            :Stay on report;
        endif
    else (Go Back / Navigate Away)
        ' → back to dashboard or projects
    endif
}

' ══════════════════════════════════════════════════════════
'  FLOW 6 — PROJECT MANAGEMENT
' ══════════════════════════════════════════════════════════
partition "Project Management" {
    :View All Projects\n(grid + stats, auto-refresh every 2s);
    :Search / Filter Projects\n(query param);

    if (Action = Click Project Card?) then (Yes)
        if (Project Status = Failed?) then (Yes)
            :No navigation\n(show failed state);
        else (Completed / Processing)
            :Navigate to Report Page;
        endif
    elseif (Action = Rename Project?) then (Yes)
        repeat
            :Open Rename Modal\n(enter new title);
            :Submit Rename\n(PATCH /api/projects);
        repeat while (Success?) is (No)
        ->Yes;
        :Update project title in grid;
    elseif (Action = Delete Project?) then (Yes)
        if (Confirm Delete?) then (Yes)
            :DELETE /api/projects\n(remove dataset + outputs);
            if (Success?) then (Yes)
                :Remove project from grid;
            else (No)
                :Show Error Alert;
            endif
        else (No)
            :Cancel deletion;
        endif
    else (Upload New Dataset)
        :Open Upload Modal;
    endif
}

stop

@enduml
