@startuml use_case_diagram
' ============================================================
' DATA ANALYTICS AI PLATFORM — FRONTEND USE CASE DIAGRAM
' ============================================================

skinparam DefaultFontName       Inter
skinparam BackgroundColor       #060e1f
skinparam ActorBackgroundColor  #1e3a5f
skinparam ActorBorderColor      #4a90d9
skinparam ActorFontColor        #e2e8f0
skinparam ActorFontStyle        Bold
skinparam UsecaseBackgroundColor #0f2340
skinparam UsecaseBorderColor    #3b82f6
skinparam UsecaseFontColor      #bfdbfe
skinparam ArrowColor            #4a6fa5
skinparam RectangleBackgroundColor #060e1f
skinparam RectangleBorderColor  #2d4a7a
skinparam RectangleFontColor    #90a4cb
skinparam RectangleFontStyle    Bold

left to right direction

' ─── ACTORS ──────────────────────────────────────────────────
actor "Guest"              as GUEST
actor "Authenticated User" as USER

' ─── SYSTEM BOUNDARY ─────────────────────────────────────────
rectangle "Data Analytics AI Application" {

    ' ── Authentication ────────────────────────────────────────
    package "Authentication" {
        usecase "UC-01\nSign Up"   as UC01
        usecase "UC-02\nSign In"   as UC02
        usecase "UC-03\nSign Out"  as UC03
    }

    ' ── Dashboard ─────────────────────────────────────────────
    package "Dashboard" {
        usecase "UC-04\nView Home Dashboard"  as UC04
        usecase "UC-05\nView Projects List"   as UC05
    }

    ' ── Upload & Analysis ─────────────────────────────────────
    package "Data Upload & Analysis" {
        usecase "UC-06\nOpen Upload Modal"                 as UC06
        usecase "UC-07\nSelect Dataset File (CSV)"         as UC07
        usecase "UC-08\nPreview Data Sample"               as UC08
        usecase "UC-09\nEnter Business Questions"          as UC09
        usecase "UC-10\nSelect AI Model"                   as UC10
        usecase "UC-11\nGenerate Insights\n(Submit)"       as UC11
        usecase "UC-12\nTrack Processing Progress\n(live)" as UC12
        usecase "UC-13\nCancel Running Analysis"           as UC13
    }

    ' ── Report & Results ──────────────────────────────────────
    package "Report & Results" {
        usecase "UC-14\nView Analysis Report"              as UC14
        usecase "UC-15\nNavigate Table of Contents"        as UC15
        usecase "UC-16\nRegenerate Report"                 as UC16
    }

    ' ── Project Management ────────────────────────────────────
    package "Project Management" {
        usecase "UC-17\nRename Project"  as UC17
        usecase "UC-18\nDelete Project"  as UC18
    }
}

' ─── GUEST ASSOCIATIONS ──────────────────────────────────────
GUEST --> UC01
GUEST --> UC02

' ─── USER ASSOCIATIONS ───────────────────────────────────────
USER --> UC03
USER --> UC04
USER --> UC05
USER --> UC06
USER --> UC13
USER --> UC14
USER --> UC16
USER --> UC17
USER --> UC18

' ─── INCLUDE (mandatory sub-steps) ──────────────────────────
UC06 .> UC07 : <<include>>
UC07 .> UC08 : <<include>>
UC07 .> UC09 : <<include>>
UC07 .> UC10 : <<include>>
UC09 .> UC11 : <<include>>
UC11 .> UC12 : <<include>>
UC05 .> UC06 : <<include>>
UC14 .> UC16 : <<include>>

' ─── EXTEND (optional steps) ─────────────────────────────────
UC12 .> UC13 : <<extend>>\n[if processing]
UC14 .> UC15 : <<extend>>

@enduml
